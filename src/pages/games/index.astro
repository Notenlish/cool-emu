---
import Layout from "src/layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Game from "src/components/Game.astro";
import {unslug, capitaliseWords} from "$lib/utils";

type RomGame = CollectionEntry<"romgames">;
type Console = RomGame["data"]["category"];

const allRomGames = await getCollection("romgames");
import { supportedConsoles } from "$lib/data/consoles";

type GenericDict<K extends string, V> = Record<K, V>;
let romGamesByConsoles: GenericDict<string, Array<RomGame>> = {};
for (const rg of allRomGames) {
    if (romGamesByConsoles[rg.data.category] == undefined) {
        romGamesByConsoles[rg.data.category] = [];
    }
    romGamesByConsoles[rg.data.category].push(rg);
}
const romGamesToMap = Object.entries(romGamesByConsoles);
---

<Layout>
    <section class="container mx-auto flex flex-col items-center mt-12 pb-12">
        <h1 class="text-4xl font-medium w-full text-center px-32">
            <span class="font-bold">Games</span>
        </h1>
        <p class="text-center w-full">
            You can find games for all the different consoles we support in
            here. Supported consoles: {
                supportedConsoles.map((e, i) => {
                    if (i == supportedConsoles.length - 1) {
                        return <span>{e.name}.</span>;
                    }
                    return <span>{e.name}, </span>;
                })
            }
        </p>
        <!-- <div>
            {allRomGames.map((game) => <Game gameObject={game} />)}
        </div> -->
        <div class="w-full">
            {
                // there has to be a better way to do this
                romGamesToMap.map((e) => {
                    const key = e[0];
                    const romGameArray = e[1];
                    return (
                        <div>
                            <h2 class="text-3xl mb-6">{capitaliseWords(unslug(key))}</h2>
                            <div class="grid gap-2 grid-cols-[repeat(auto-fit,minmax(200px,1fr))]">
                                {romGameArray.map((g) => {
                                    return <Game gameObject={g} />;
                                })}
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </section>
</Layout>
