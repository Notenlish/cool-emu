---
import Layout from "src/layouts/Layout.astro";
import { supportedConsoles } from "$lib/data/consoles";
import AllFeaturedGamesOfAllConsoles from "src/components/AllFeaturedGamesOfAllConsoles.astro";
---

<Layout>
    <section
        class="container grow mx-auto flex flex-col items-center mt-[10vh] pb-12"
    >
        <h1 class="text-4xl font-medium w-full text-center px-32 mb-2">
            <span class="font-bold">Games</span>
        </h1>
        <p class="text-center w-full pb-12">
            You can find games for all the different consoles we support in
            here. Supported consoles: {
                supportedConsoles.map((e, i) => {
                    if (i == supportedConsoles.length - 1) {
                        return <span>{e.name}.</span>;
                    }
                    return <span>{e.name}, </span>;
                })
            }
        </p>
        <AllFeaturedGamesOfAllConsoles />
        <!-- <div>
            {allRomGames.map((game) => <Game gameObject={game} />)}
        </div> -->
    </section>
</Layout>
