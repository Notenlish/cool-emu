---
import type { GetStaticPaths } from "astro";
import Layout from "src/layouts/Layout.astro";
import Game from "src/components/Game.astro";
import { unslug, capitaliseWords } from "$lib/utils";
import { Button } from "$lib/components/ui/button";
import Image from "astro/components/Image.astro";
import { supportedConsoles } from "$lib/data/consoles";

export const getStaticPaths = (() => {
    return [
        {
            params: { console: "sega-saturn" },
        },
    ];
}) satisfies GetStaticPaths;
const { console } = Astro.params;

//
//

import { getCollection, type CollectionEntry } from "astro:content";
type RomGame = CollectionEntry<"romgames">;
type Console = RomGame["data"]["category"];
type GenericDict<K extends string, V> = Record<K, V>;

const allRomGames = await getCollection("romgames");

let romGamesByConsoles: GenericDict<string, Array<RomGame>> = {};
for (const rg of allRomGames) {
    if (romGamesByConsoles[rg.data.category] == undefined) {
        romGamesByConsoles[rg.data.category] = [];
    }
    romGamesByConsoles[rg.data.category].push(rg);
}
const key = console;
const romGameArray = romGamesByConsoles[console];

//

const playConsoleMetadata = supportedConsoles.find((e) => e.id == key);
---

<Layout>
    <div class="w-full sm:container sm:mx-auto px-2 pt-[15vh]">
        <div>
            <div
                class="w-full flex flex-col lg:flex-row lg:gap-2 mb-4 justify-between"
            >
                <h2 class="text-3xl sm:mx-0! sm:m-2! mb-6">
                    Find Games for {capitaliseWords(unslug(key))}
                </h2>
                <Button
                    variant="link"
                    href={playConsoleMetadata.playUrl}
                    size="lg"
                    class="text-white rounded cursor-pointer flex gap-2 w-fit p-3 hover:opacity-60"
                    style={`background-color: ${playConsoleMetadata.color};`}
                >
                    <Image
                        height={42}
                        width={42}
                        src={playConsoleMetadata.imgUrl}
                        alt="controller"
                    />
                    Play {playConsoleMetadata.name}
                </Button>
            </div>
            <div
                class="grid gap-2 grid-cols-[repeat(auto-fit,minmax(160px,1fr))]"
            >
                {
                    romGameArray.map((g) => {
                        return (
                            <Game
                                consoleCategory={playConsoleMetadata?.id}
                                gameObject={g}
                            />
                        );
                    })
                }
            </div>
        </div>
    </div>
</Layout>
