---
import PlayConsole from "src/components/PlayConsole.astro";
import Layout from "src/layouts/Layout.astro";
import GameboyImage from "$assets/consoles/gameboy.png";
import Controls from "src/components/Controls.astro";
import SimpleLink from "$lib/components/ui/SimpleLink/SimpleLink.svelte";
import AboutConsole from "src/components/aboutConsole.astro";

import { getAllRomGamesOfConsole } from "src/data/roms";
import FeaturedGamesOfConsole from "src/components/FeaturedGamesOfConsole.astro";
const gamesToMap = await getAllRomGamesOfConsole("gameboy");

const controlsData = [
  { name: "Button A", key: "Z" },
  { name: "Button B", key: "X" },
  { name: "Select", key: "V" },
  { name: "Start", key: "Enter" },
  { name: "Up", key: "Up Arrow" },
  { name: "Down", key: "Down Arrow" },
  { name: "Left", key: "Left Arrow" },
  { name: "Right", key: "Right Arrow" },
  { name: "Quick Save", key: "1" },
  { name: "Quick Load", key: "2" },
  { name: "Change Save Slot", key: "3" },
];
---

<Layout>
  <PlayConsole
    title="Gameboy"
    description="You can play any GameBoy(GB) game by uploading the game's ROM file here. Bios file optional."
    aspectRatioTailwind="aspect-[10/9]"
    core="gb"
  />
  <Controls rows={controlsData} />
  <section id="featuredGames" class="mx-auto container">
    <FeaturedGamesOfConsole
      romGameArray={gamesToMap}
      consoleCategory={"gameboy"}
      variant="differentTitle"
    />
  </section>
  <AboutConsole
    title="GameBoy (Nintendo GameBoy)"
    NesConsoleImage={GameboyImage}
    height={1080*0.35}
    width={891*0.35}
    imgStyle="object-contain !aspect-square"
  >
    <p slot="description">
      The GameBoy (GB) is a handheld video game console developed by Nintendo.
      It was released in Japan on <time datetime="1989-4-21"
        >21st of April 1989</time
      > and in the US on <time datetime="1989-7-31">July 31, 1989</time>.
      Nintendo Entertainment System competed with Sega's Game Gear systems as
      well as Atari's Lynx systems.
      <br />
      The hardware of the GameBoy was developed by focusing on affordability, battery
      life and durability, compared to their competitors which focused on faster processors
      and color graphics. Despite being an underpowered system for the time, the GameBoy's
      low price, long battery life and incredible game library at the time brought
      in high sales worldwide. The success of the Pokemon series also helped with
      the popularity of the GameBoy.
    </p>
    <div slot="attribution">
      GameBoy image by
      <SimpleLink
        target="_blank"
        href="https://commons.wikimedia.org/wiki/User:Evan-Amos"
        >Evan-Amos</SimpleLink
      > - <span class="int-own-work" lang="en">Own work</span>, Public Domain, <SimpleLink
        target="_blank"
        href="https://commons.wikimedia.org/w/index.php?curid=37808150"
        >Link</SimpleLink
      >.
       JPEG version and remove white background by Transfrom.
    </div>
  </AboutConsole>
</Layout>
