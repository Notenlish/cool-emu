---
import PlayConsole from "src/components/PlayConsole.astro";
import Layout from "src/layouts/Layout.astro";
import NDSConsoleImage from "$assets/consoles/nintendo-ds.png";
import Controls from "src/components/Controls.astro";
import SimpleLink from "$lib/components/ui/SimpleLink/SimpleLink.svelte";
import AboutConsole from "src/components/aboutConsole.astro";

import { getAllRomGamesOfConsole } from "src/data/roms";
import FeaturedGamesOfConsole from "src/components/FeaturedGamesOfConsole.astro";
const gamesToMap = await getAllRomGamesOfConsole("nintendo-ds");

const controlsData = [
  { name: "Button A", key: "Z" },
  { name: "Button B", key: "X" },
  { name: "Button X", key: "A" },
  { name: "Button Y", key: "S" },
  { name: "Select", key: "V" },
  { name: "Start", key: "Enter" },
  { name: "Up", key: "Up Arrow" },
  { name: "Down", key: "Down Arrow" },
  { name: "Left", key: "Left Arrow" },
  { name: "Right", key: "Right Arrow" },
  { name: "Button L", key: "Q" },
  { name: "Button R", key: "E" },
  { name: "Quick Save", key: "1" },
  { name: "Quick Load", key: "2" },
  { name: "Change Save Slot", key: "3" },
];
---

<Layout>
  <PlayConsole
    title="Nintendo DS"
    description="You can play any Nintendo DS game by uploading the game's ROM file here. Bios file optional."
    aspectRatioTailwind="aspect-[4/3]"
    core="nds"
  />
  <Controls rows={controlsData} />
  <section id="featuredGames" class="mx-auto container">
    <FeaturedGamesOfConsole
      romGameArray={gamesToMap}
      consoleCategory={"nintendo-ds"}
      variant="differentTitle"
    />
  </section>
  <AboutConsole
    height={270*1.1}
    width={300*1.1}
    title="Nintendo DS (Nintendo Dual Screen)"
    imgStyle="object-contain"
    NesConsoleImage={NDSConsoleImage}
  >
    <p slot="description">
      The Nintendo DS (NDS) is a foldable video game console developed by
      Nintendo which was released worldwide in 2004. The "DS" in the name stood
      for Dual Screen, with the lower screen having a touchscreen. The Nintendo
      DS was one of the first portable game consoles to support wifi for local
      multiplayer over short distances, as well as supporting online play
      through Nintendo Wi-Fi Connection Service. Nintendo DS primarily competed
      with the Playstation Portable(PSP).
      <br />
      <br />
      Hardware of the Nintendo DS was based on a 67 MHz ARM946E-S 33 MHz ARM7TDMI
      chips with 4 MB RAM. The device had 256 MB of flash storage as well as cartridge
      save functionality. The Nintendo DS was a success for Nintendo and it has sold
      154 million units as of date, which was the highest selling console Nintendo
      has ever made until the Nintendo Switch surpassed the Nintendo DS in number
      of units sold. Nintendo DS is still cherished as a great console by many and
      people over the world are nostalgic towards it.
    </p>
    <div slot="attribution">
      NES image by
      <SimpleLink
        target="_blank"
        href="https://commons.wikimedia.org/wiki/User:Evan-Amos">Evan-Amos</SimpleLink
      > - <span class="int-own-work" lang="en">Own work</span>, Public Domain, <SimpleLink
        target="_blank"
        href="https://commons.wikimedia.org/w/index.php?curid=14501145"
        >Link</SimpleLink
      >
    </div>
  </AboutConsole>
</Layout>
