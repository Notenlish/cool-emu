---
import PlayConsole from "src/components/PlayConsole.astro";
import Layout from "src/layouts/Layout.astro";
import N64ConsoleImage from "$assets/consoles/n64.png";
import Controls from "src/components/Controls.astro";
import SimpleLink from "$lib/components/ui/SimpleLink/SimpleLink.svelte";
import AboutConsole from "src/components/aboutConsole.astro";

import { getAllRomGamesOfConsole } from "src/data/roms";
import FeaturedGamesOfConsole from "src/components/FeaturedGamesOfConsole.astro";
const gamesToMap = await getAllRomGamesOfConsole("nintendo-64");

const controlsData = [
    { name: "Button A", key: "X" },
    { name: "Button B", key: "S" },
    { name: "Start", key: "Enter" },
    { name: "Up", key: "Up Arrow" },
    { name: "Down", key: "Down Arrow" },
    { name: "Left", key: "Left Arrow" },
    { name: "Right", key: "Right Arrow" },
    { name: "L", key: "Q" },
    { name: "R", key: "e" },
    { name: "Z", key: "Tab" },
    { name: "Stick Up", key: "T" },
    { name: "Stick Down", key: "G" },
    { name: "Stick Left", key: "F" },
    { name: "Stick Right", key: "H" },
    { name: "C-Pad Up", key: "I" },
    { name: "C-Pad Down", key: "K" },
    { name: "C-Pad Right", key: "L" },
    { name: "C-Pad Left", key: "J" },
    { name: "Quick Save", key: "1" },
    { name: "Quick Load", key: "2" },
    { name: "Change Save Slot", key: "3" },
];
---

<Layout>
    <PlayConsole
        title="Nintendo 64"
        description="You can play any Nintendo 64 game by uploading the game's ROM file here. Bios file optional."
        aspectRatioTailwind="aspect-[4/3]"
        core="n64"
    />
    <Controls rows={controlsData} />
    <section id="featuredGames" class="mx-auto container">
        <FeaturedGamesOfConsole
            romGameArray={gamesToMap}
            consoleCategory={"nintendo-64"}
            variant="differentTitle"
        />
    </section>
    <AboutConsole title="Nintendo 64 (N64)" consoleImage={N64ConsoleImage}>
        <p slot="description">
            Nintendo 64 (N64) is a video game console developed and sold by
            Nintendo. It was released in Japan on <time datetime="1996-6-23"
                >23rd of June 1996</time
            >. It was released in the US on <time datetime="1996-9-23"
                >September 29, 1996</time
            >. N64 was Nintendo's third major game console and competed with
            Sony's Playstation and Sega Saturn as the fifth generation of
            consoles.
            <br />
            The hardware of the Nintendo 64 was a 64 bit architecture co-developed
            with Silicon Graphics. The coprocessor found on the device for processing
            graphics allowed for improved 3D capabilities. While N64 was a successful
            console and outsold the Sega Saturn, it was less successful than Playstation.
            N64 is regarded as one of the most iconic game consoles of all time.
        </p>
        <div slot="attribution">
            Nintendo 64 image by
            <SimpleLink
                target="_blank"
                href="https://commons.wikimedia.org/wiki/User:Evan-Amos"
                >Evan-Amos</SimpleLink
            > - <span class="int-own-work" lang="en">Own work</span>, Public
            Domain, <SimpleLink
                target="_blank"
                href="https://commons.wikimedia.org/w/index.php?curid=12814248"
                >Link</SimpleLink
            >
        </div>
    </AboutConsole>
</Layout>
