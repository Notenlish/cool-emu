---
import PlayConsole from "src/components/PlayConsole.astro";
import Layout from "src/layouts/Layout.astro";
import PlaystationImage from "$assets/consoles/playstation.png";
import Controls from "src/components/Controls.astro";
import SimpleLink from "$lib/components/ui/SimpleLink/SimpleLink.svelte";
import AboutConsole from "src/components/aboutConsole.astro";

import { getAllRomGamesOfConsole } from "src/data/roms";
import FeaturedGamesOfConsole from "src/components/FeaturedGamesOfConsole.astro";

const gamesToMap = await getAllRomGamesOfConsole("playstation");

const controlsData = [
  { name: "Button A", key: "Z" },
  { name: "Button B", key: "X" },
  { name: "Button L", key: "Q" },
  { name: "Button R", key: "E" },
  { name: "Select", key: "V" },
  { name: "Start", key: "Enter" },
  { name: "Up", key: "Up Arrow" },
  { name: "Down", key: "Down Arrow" },
  { name: "Left", key: "Left Arrow" },
  { name: "Right", key: "Right Arrow" },
  { name: "Quick Save", key: "1" },
  { name: "Quick Load", key: "2" },
  { name: "Change Save State", key: "3" },
];
---

<Layout>
  <PlayConsole
    title="Playstation (PS)"
    description="You can play any Playstation game by uploading the game's file here."
    aspectRatioTailwind="aspect-[4/3]"
    core="ps"
  />
  <Controls rows={controlsData} />
  <section id="featuredGames" class="mx-auto container">
    <FeaturedGamesOfConsole
      romGameArray={gamesToMap}
      consoleCategory="playstation"
      variant="differentTitle"
    />
  </section>
  <AboutConsole
    title="Playstation(PS)"
    consoleImage={PlaystationImage}
    width={1043 * 0.25}
    height={720 * 0.25}
    imgStyle="object-contain !aspect-square"
  >
    <p slot="description">
      The Playstation (PS) is a handheld video game console manufactured and
      sold by Sony. It was released in Japan on <time datetime="03-12-1994"
        >December 3rd, 1994</time
      > and in North America on <time datetime="09-09-1995"
        >9th of September, 1995</time
      >. It primarily competed against Nintendo's N64 and Sega Saturn consoles.
      <br />
      The Playstation's hardware included a 32 bit RISC CPU with 2 MB ram and 1 MB
      video ram. The Playstation was weak compared to its competitor Nintendo 64 system
      but it made up for it with its relatively abundant storage space on discs. The
      console saw huge popularity when it was first released, and it has become the
      first computer entertainment platform to ship over 100 million units. The best-selling
      game for the console, Gran Turismo has sold a total of 10.85 million copies.
    </p>
    <div slot="attribution">
      Playstation image by
      <SimpleLink
        target="_blank"
        href="https://commons.wikimedia.org/wiki/User:Evan-Amos"
        >Evan-Amos</SimpleLink
      > -<span class="int-own-work" lang="en"> Own work</span>, Public Domain, <SimpleLink
        target="_blank"
        href="https://commons.wikimedia.org/w/index.php?curid=52461914"
        >Link</SimpleLink
      >.
    </div>
  </AboutConsole>
</Layout>
