---
import PlayConsole from "src/components/PlayConsole.astro";
import Layout from "src/layouts/Layout.astro";
import SegaSaturnImage from "$assets/consoles/sega-saturn.png";
import Controls from "src/components/Controls.astro";
import SimpleLink from "$lib/components/ui/SimpleLink/SimpleLink.svelte";
import AboutConsole from "src/components/aboutConsole.astro";

import { getAllRomGamesOfConsole } from "src/data/roms";
import FeaturedGamesOfConsole from "src/components/FeaturedGamesOfConsole.astro";

const gamesToMap = await getAllRomGamesOfConsole("sega-saturn");

const controlsData = [
  { name: "Button A", key: "Z" },
  { name: "Button B", key: "X" },
  { name: "Button L", key: "Q" },
  { name: "Button R", key: "E" },
  { name: "Select", key: "V" },
  { name: "Start", key: "Enter" },
  { name: "Up", key: "Up Arrow" },
  { name: "Down", key: "Down Arrow" },
  { name: "Left", key: "Left Arrow" },
  { name: "Right", key: "Right Arrow" },
  { name: "Quick Save", key: "1" },
  { name: "Quick Load", key: "2" },
  { name: "Change Save State", key: "3" },
];
---

<Layout>
  <PlayConsole
    title="Sega Saturn"
    description="You can play any Sega Saturn game by uploading the game's file here."
    aspectRatioTailwind="aspect-[4/3]"
    core="gba"
  />
  <Controls rows={controlsData} />
  <section id="featuredGames" class="mx-auto container">
    <FeaturedGamesOfConsole
      romGameArray={gamesToMap}
      consoleCategory="sega-saturn"
      variant="differentTitle"
    />
  </section>
  <AboutConsole
    title="Sega Saturn"
    consoleImage={SegaSaturnImage}
    width={1280 * 0.25}
    height={719 * 0.25}
    imgStyle="object-contain !aspect-square"
  >
    <p slot="description">
      The Sega Saturn is a handheld video game console developed by Sega and
      released on <time datetime="22-11-1994">November 22, 1994</time> in Japan, <time
        datetime="11-05-1995">May 11, 1995</time
      > in North America. As part of the fifth generation of video game consoles,
      the Sega Saturn mainly competed against the Sony Playstation.
      <br />
      The Sega Saturn uses 2x Hitachi SH-2 cores clocked in at 28.6 Mhz. It features
      2 MB ram and 1.5 MB vram. Although Sega Saturn was initially successful in Japan,
      it failed to compete in the United States
    </p>
    <div slot="attribution">
      Sega Saturn image by
      <SimpleLink
        target="_blank"
        href="https://commons.wikimedia.org/wiki/User:Evan-Amos"
        >Evan-Amos</SimpleLink
      > -<span class="int-own-work" lang="en"> Own work</span>, Public Domain, <SimpleLink
        target="_blank"
        href="https://commons.wikimedia.org/w/index.php?curid=12310501"
        >Link</SimpleLink
      >.
    </div>
  </AboutConsole>
</Layout>
