---
import PlayConsole from "src/components/PlayConsole.astro";
import Layout from "src/layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import SnesConsoleImage from "$assets/consoles/snes.jpg";
import Controls from "src/components/Controls.astro";
import SimpleLink from "$lib/components/ui/SimpleLink/SimpleLink.svelte";
import AboutConsole from "src/components/aboutConsole.astro";

import { getAllRomGamesOfConsole } from "src/data/roms";
import FeaturedGamesOfConsole from "src/components/FeaturedGamesOfConsole.astro";
const gamesToMap = await getAllRomGamesOfConsole("super-nintendo");

const controlsData = [
    { name: "Button A", key: "Z" },
    { name: "Button B", key: "X" },
    { name: "Select", key: "V" },
    { name: "Start", key: "Enter" },
    { name: "Up", key: "Up Arrow" },
    { name: "Down", key: "Down Arrow" },
    { name: "Left", key: "Left Arrow" },
    { name: "Right", key: "Right Arrow" },
    { name: "Swap Disks", key: "Q" },
    { name: "Eject/Insert Disk", key: "E" },
    { name: "Quick Save", key: "1" },
    { name: "Quick Load", key: "2" },
    { name: "Change Save State", key: "3" },
];
---

<Layout>
    <PlayConsole
        title="SNES"
        description="You can play any SNES game by uploading the game's ROM file here. Bios file optional."
        aspectRatioTailwind="aspect-[4/3]"
        core="snes"
    />
    <Controls rows={controlsData} />
    <section id="featuredGames" class="mx-auto container">
        <FeaturedGamesOfConsole
            romGameArray={gamesToMap}
            consoleCategory={"super-nintendo"}
            variant="differentTitle"
        />
    </section>
    <AboutConsole
        title="SNES (Super Nintendo Entertainment System)"
        NesConsoleImage={SnesConsoleImage}
    >
        <p slot="description">
            Super Nintendo Entertainment System(SNES) is a video game console
            developed by Nintendo. It was released under the name "Super
            Famicom" in Japan on <time datetime="1990-11-21"
                >21st of November 1990</time
            >. It was released in the US on <time datetime="1991-8-23"
                >August 23, 1991</time
            >. SNES was the second home console sold by Nintendo and it
            primarily competed with Sega's Genesis at the time.
            <br />
            The hardware of the NES was a 16 bit architecture that was developed as
            a response to the introduction of Genesis and Turbografx-16. It had a
            wide range of features such as being able to simulate 3D perspective and
            interfacing with enhancement chips such as SuperFx within game cartridges.
        </p>
        <div slot="attribution">
            SNES image by
            <SimpleLink
                target="_blank"
                href="//commons.wikimedia.org/wiki/User:Evan-Amos"
                >Evan-Amos</SimpleLink
            > - <span class="int-own-work" lang="en">Own work</span>, Public
            Domain, <SimpleLink
                target="_blank"
                href="https://commons.wikimedia.org/w/index.php?curid=17748368"
                >Link</SimpleLink
            >
        </div>
    </AboutConsole>
</Layout>
