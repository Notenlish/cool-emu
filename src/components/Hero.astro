//
---

<section
  id="hero"
  class="mt-[15vh] md:grid place-content-center mb-24 w-full px-2 relative overflow-x-clip"
>
  <div
    class="md:container md:mx-auto md:grid md:place-content-center static w-full"
  >
    <div class="h-0 block">
      <img
        src="/trophy-pixelated.svg"
        alt="trophy"
        class="hover left-2/18 sm:left-1/14 -top-1/12 sm:-top-1/6 lg:top-1/4 size-8 md:size-12 opacity-60"
      />
      <img
        src="/archery-pixelated.svg"
        alt="trophy"
        class="absolute left-3/15 sm:left-1/9 bottom-10/15 sm:bottom-3/5 lg:bottom-1/9 size-8 md:size-12 opacity-60 animate-[hoverAnim_0.76s_ease-in-out_0.3s_infinite_alternate]"
      />
      <img
        src="/star-pixelated.svg"
        alt="Pixelated Controller"
        class="absolute top-3/12 sm:top-2/6 lg:top-3/6 right-2/11 sm:right-1/7 lg:right-1/8 size-8 md:size-12 opacity-60 animate-[hoverAnim_1.6s_ease-in-out_0.2s_infinite_alternate]"
      />
      <img
        src="/sword-pixelated.svg"
        alt="Pixelated Sword"
        class="rotate-180 absolute -top-1/12 sm:-top-1/10 lg:top-1/8 right-24 size-8 md:size-12 opacity-60 animate-[hoverAnim_1.8s_ease-in-out_0.1s_infinite_alternate]"
      />
    </div>
    <div class="flex flex-col items-center w-full">
      <div class="mb-16 lg:mb-12 w-full">
        <h1
          class="text-2xl md:text-4xl lg:text-4xl font-medium w-full text-center px-0 md:px-16 lg:px-32"
        >
          <span
            class="bg-clip-text text-transparent bg-linear-to-r from-cyan-500 to-blue-500 font-bold"
            >Cool Emu</span
          >
          <span>is</span>
          <span>a</span>
          <span>web</span>
          <span>based</span>
          <br />
          <div
            class="flex gap-2 w-full flex-wrap justify-center md:flex-nowrap"
          >
            <span>console</span>
            <span>emulator</span>
            <span>for</span>
            <div
              class="min-w-10 pb-2 font-bold select-none flex items-center sm:items-start"
              id="text-rotator"
            >
              <span class="text-blue-600">NES</span>
              <span class="text-green-600">SNES</span>
              <span class="text-blue-600">Playstation</span>
              <span class="text-red-600">Gameboy</span>
              <span class="text-sky-600">PSP</span>
            </div>
          </div>
        </h1>
        <h2 class="text-center text-sm md:text-lg text-primary/70">
          Currently supporting emulation of 5+ game consoles.
        </h2>
      </div>
      <p class="text-wrap w-full">
        Welcome to <strong>Cool Emu</strong>, a web based console emulator! On
        this site you can play all sorts of games from NES classics such as
        Super Mario Bros to PSP games like Patapon! All you need to do is head
        over to the respective games console and then put in the game ROM file.
      </p>
      <p>
        For legal reasons we don't host game ROMS, however we hope you can
        acquire the ROM of the game you are looking to play. Have fun! If you
        like this website, you can share it with others!
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  const container = document.getElementById("text-rotator");
  if (!container) throw new Error("text-rotator doesnt exist!");

  let words = Array.from(container.children as HTMLCollectionOf<HTMLElement>);

  let longest = 0;
  let height = words[0].getBoundingClientRect().height + 3;
  for (const [key, value] of words.entries()) {
    value.style.position = "absolute";
    value.style.transform = `translate(0,${key * height}px)`;
    if (value.textContent.length >= longest) {
      longest = value.textContent.length;
    }
  }
  container.style.width = `${longest * 20}px`;
  container.style.height = `${height}px`;

  // change over time
  setInterval(() => {
    words = Array.from(container.children as HTMLCollectionOf<HTMLElement>);

    // move the element at the top to the bottom
    let firstEl = words[0];
    words[0].remove();
    container.appendChild(firstEl);

    for (const [key, value] of words.entries()) {
      gsap.fromTo(
        value,
        {
          translateY: key * height,
        },
        {
          translateY: (key - 1) * height,
        },
      );
    }
  }, 1000);
</script>
