---
import type { CollectionEntry } from "astro:content";

import NotFoundImage from "$assets/image-not-found.png";
import Image from "astro/components/Image.astro";
interface Props {
    gameObject: CollectionEntry<"romgames">;
    consoleCategory: string;
    layout: "grid" | "flex";
}
const { gameObject, consoleCategory, layout } = Astro.props;
---

<div
    class={`min-w-32 flex flex-col items-center grow ${layout == "flex" && "min-w-40"}`}
>
    <Image
        width={144}
        height={144}
        class={"aspect-9/16 object-cover"}
        src={gameObject.data.imgPath
            ? `/${gameObject.data.imgPath}`
            : NotFoundImage}
        alt={gameObject.data.name}
    />
    <a
        href={`/games/${consoleCategory}/${gameObject.id}`}
        class="text-center line-clamp-3">{gameObject.data.name}</a
    >
</div>
