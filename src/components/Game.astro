---
import type {
    CollectionEntry,
    CollectionKey,
    ContentCollectionKey,
    DataCollectionKey,
    SchemaContext,
} from "astro:content";

import NotFoundImage from "$assets/image-not-found.png";
import Image from "astro/components/Image.astro";
interface Props {
    gameObject: CollectionEntry<"romgames">;
    layout: "grid" | "flex";
}
const { gameObject, layout } = Astro.props;
---

<div class={`min-w-32 flex flex-col items-center grow ${layout == "flex" && "min-w-40"}`}>
    <Image
        width={144}
        height={144}
        src={gameObject.data.imgPath
            ? `/${gameObject.data.imgPath}`
            : NotFoundImage}
        alt={gameObject.data.name}
    />
    <span class="text-center block">{gameObject.data.name}</span>
</div>
